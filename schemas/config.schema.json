{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBP config",
  "type": "object",
  "properties": {
    "coverage_json": {
      "type": "string"
    },
    "coverage_allowlist": {
      "type": "string"
    },
    "target_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policy_file": {
      "type": "string"
    },
    "coverage_threshold": {
      "type": "number"
    },
    "policy_threshold": {
      "type": "number"
    },
    "dependency_lock": {
      "type": "string"
    },
    "install_command": {
      "type": "string"
    },
    "docs_manifest": {
      "type": "string"
    },
    "comment_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "binary_artifacts": {
      "type": "string"
    },
    "binary_limit_mb": {
      "type": "number"
    },
    "package_zip": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims_manifest": {
      "type": [
        "string",
        "null"
      ]
    },
    "claims_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "enable_coverage": {
      "type": "boolean"
    },
    "enable_dependency": {
      "type": "boolean"
    },
    "enable_comments": {
      "type": "boolean"
    },
    "enable_docs": {
      "type": "boolean"
    },
    "enable_binary": {
      "type": "boolean"
    },
    "enable_claims": {
      "type": "boolean"
    },
    "coverage_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "files",
          "threshold",
          "mode"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "threshold": {
            "type": "number"
          },
          "mode": {
            "enum": [
              "enforce",
              "warn"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "enable_encoding": {
      "type": "boolean"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "custom_rules": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_readers": {
      "type": "object"
    },
    "release_body": {
      "type": "string"
    },
    "coverage_signature": {
      "type": "string"
    },
    "require_coverage_signature": {
      "type": "boolean"
    },
    "enable_custom": {
      "type": "boolean"
    },
    "baseline": {
      "type": "string"
    },
    "required_artifacts": {
      "type": "array",
      "description": "Required when package_zip is configured."
    },
    "packs": {
      "type": "array"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version"
  ]
}
