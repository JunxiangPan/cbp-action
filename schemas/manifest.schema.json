{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CBP quality manifest (CONTRACT v1.7)",
  "type": "object",
  "required": [
    "schema_version",
    "package_id",
    "producer_id",
    "version",
    "gate_status",
    "applicable_gate_count",
    "skip_count",
    "skip_ratio",
    "blocking_skip",
    "gates",
    "artifact_hashes",
    "release_body_hash",
    "evidence_sha256",
    "body_hash_scope"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "package_id": {"type": "string", "minLength": 1},
    "producer_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "gate_status": {"enum": ["PASS", "FAIL", "SKIPPED_INFRA", "PRECONDITION_FAIL"]},
    "applicable_gate_count": {"type": "integer", "minimum": 0},
    "skip_count": {"type": "integer", "minimum": 0},
    "skip_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "blocking_skip": {"type": "boolean"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL", "SKIPPED"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "release_body_hash": {"$ref": "#/$defs/hash"},
    "evidence_sha256": {"$ref": "#/$defs/hash"},
    "body_hash_scope": {"enum": ["base", "full"]},
    "artifact_repository": {"type": "string"},
    "ci_run_id": {"type": "string"},
    "ci_commit_sha": {"type": "string"}
  },
  "additionalProperties": true,
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
